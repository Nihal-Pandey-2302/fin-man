/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * One Worker serves the SPA (static assets) and the JSON API under /api/*.
 * Local dev uses a local D1 in .wrangler/state; nothing here touches Cloudflare until you deploy.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fintrack",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-23",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fintrack",
			// The deployed database (an identifier, not a secret: using it needs the owner's Cloudflare login).
			"database_id": "a57d4f67-1608-4201-bff2-a228f3221ac0",
			"migrations_dir": "migrations"
		}
	],
	// Weekly automatic backups (worker/backup.ts). An identifier, not a secret.
	"kv_namespaces": [
		{
			"binding": "BACKUPS",
			"id": "99e250c989854856a4703c8ed53669c3"
		}
	],
	// 03:30 UTC = 09:00 IST: daily reminders (card due, autopays, salary, review inbox).
	// Sat 21:00 UTC = Sun 02:30 IST: weekly backup into Workers KV (BACKUPS binding, see worker/backup.ts).
	// Sun 14:00 UTC = Sun 19:30 IST: weekly digest push (worker/ledger/digest.ts).
	"triggers": {
		"crons": ["30 3 * * *", "0 21 * * 6", "0 14 * * 0"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
